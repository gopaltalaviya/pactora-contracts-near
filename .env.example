# Copy to .env (gitignored). Testnet only. Never put a real key in this file:
# it is tracked. Load it with: node --env-file=.env scripts/<script>.mjs

# Optional: NEAR testnet RPC. FastNEAR's is the default: rpc.testnet.near.org
# is deprecated and rate-limited (it answered 429 "switch to fastnear" and
# dropped a 400 KB deploy mid-upload, 2026-11-10). Both answer chain_id "testnet".
RPC_URL_TESTNET=https://test.rpc.fastnear.com

# The account that deploys and owns the contracts on testnet (a funded
# .testnet account), and its full-access key (ed25519:...). Set only in .env.
DEPLOYER_ACCOUNT_ID=
DEPLOYER_SECRET_KEY=

# The DAO council is the deployer plus two more accounts. Either set two
# testnet accounts of your own here (ids and their keys, in .env only) before
# running scripts/create-dao.mjs, or leave them out: it then creates
# council-1/council-2.<deployer> and writes their ids and keys here. It writes
# ARBITER_ACCOUNT_ID (the 2-of-3 Sputnik DAO) either way.
# COUNCIL_1_ACCOUNT_ID, COUNCIL_1_SECRET_KEY, COUNCIL_2_ACCOUNT_ID, COUNCIL_2_SECRET_KEY

# Optional overrides (leave commented to use the committed, hash-checked
# wasm/*.wasm). An override skips the SHA256SUMS check: use it only for a
# build of your own.
# PACTORA_WASM=
# MOCK_USDC_WASM=

# Sandbox only.
# SANDBOX_KEY_FILE=
# SPUTNIK_DAO_WASM=
