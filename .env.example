# Copy to .env (gitignored). Testnet only. Never put a real key in this file:
# it is tracked. Load it with: node --env-file=.env scripts/<script>.mjs

# Optional: NEAR testnet RPC (rpc.testnet.near.org and test.rpc.fastnear.com
# both answer chain_id "testnet"; checked 2026-11-05).
RPC_URL_TESTNET=https://rpc.testnet.near.org

# The account that deploys and owns the contracts on testnet (a funded
# .testnet account), and its full-access key (ed25519:...). Set only in .env.
DEPLOYER_ACCOUNT_ID=
DEPLOYER_SECRET_KEY=

# Written by scripts/create-dao.mjs --network testnet — do not fill by hand:
# COUNCIL_1_ACCOUNT_ID, COUNCIL_1_SECRET_KEY, COUNCIL_2_ACCOUNT_ID,
# COUNCIL_2_SECRET_KEY, ARBITER_ACCOUNT_ID (the 2-of-3 Sputnik DAO).

# Optional overrides (leave commented to use the committed, hash-checked
# wasm/*.wasm). An override skips the SHA256SUMS check: use it only for a
# build of your own.
# PACTORA_WASM=
# MOCK_USDC_WASM=

# Sandbox only.
# SANDBOX_KEY_FILE=
# SPUTNIK_DAO_WASM=
