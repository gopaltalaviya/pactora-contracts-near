# Copy to .env (gitignored). Testnet only. Never put a real key in this file:
# it is tracked.

# NEAR testnet RPC (both answer chain_id "testnet"; checked 2026-11-05).
NEAR_RPC_URL=https://rpc.testnet.near.org

# The account that deploys and owns the contracts on testnet, and its key
# (ed25519:...). Leave the key empty here; set it only in .env.
NEAR_DEPLOYER_ACCOUNT=
NEAR_DEPLOYER_PRIVATE_KEY=

# Accounts the deploy script grants roles to.
NEAR_ARBITER_ACCOUNT=
NEAR_PAUSER_ACCOUNT=
NEAR_FEE_RECIPIENT=
